# ================================
# HAZEL STOCK MANAGEMENT - ENVIRONMENT VARIABLES
# ================================

# Database Configuration (Required)
# Replace with your actual database credentials
DB_HOST=your-database-host.com
DB_PORT=3306
DB_NAME=your-database-name
DB_USER=your-username
DB_PASS=your-password

# Example for Aiven Cloud Database:
# DB_HOST=mysql-xxxxx-yourproject.f.aivencloud.com
# DB_PORT=18463
# DB_NAME=defaultdb
# DB_USER=avnadmin
# DB_PASS=your-actual-password-here

# Note: For production deployment on Render.com or similar platforms,
# set these environment variables in your hosting platform's dashboard
# DO NOT commit actual credentials to version control