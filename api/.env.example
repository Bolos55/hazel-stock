# Environment Variables Configuration
# คัดลอกไฟล์นี้เป็น .env และแก้ไขค่าตามความเหมาะสม

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=restaurant_stock
DB_USER=root
DB_PASS=

# Database SSL (ถ้าใช้)
# DB_SSL_CA=/path/to/ca-cert.pem

# Application URL (สำหรับ cron job ใช้สร้าง URL รูปภาพ)
APP_URL=http://localhost

# Email Configuration (ถ้าต้องการส่ง email)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-password
# MAIL_FROM=noreply@restaurant.com
# MAIL_TO=manager@restaurant.com

# Timezone
TZ=Asia/Bangkok

# Environment (development, production)
APP_ENV=development

# Debug Mode (true, false)
APP_DEBUG=false
