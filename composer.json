{
    "name": "restaurant/stock-system",
    "description": "Restaurant Daily Stock Recording System with Photo Proof",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Restaurant Stock Team",
            "email": "support@restaurant.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-zip": "*",
        "ext-xml": "*",
        "phpoffice/phpspreadsheet": "^1.29"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "files": [
            "config.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "php test_db.php",
        "export": "php cron/daily-excel-export.php"
    }
}
